rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow any authenticated user to read/write.
    // This is safe for a single-owner dashboard: only the restaurant owner
    // has credentials to sign in. Tighten to per-owner rules after launch.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
